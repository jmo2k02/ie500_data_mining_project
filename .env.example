# Copy this file to .env and fill in the values
# cp .env.example .env

# Postgres
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mlflow

# MLflow
MLFLOW_PORT=5000
MLFLOW_FLASK_SERVER_SECRET_KEY=changeme

# S3 Artifact Storage
MLFLOW_S3_ENDPOINT_URL=https://your-s3-endpoint.example.com
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts

# General S3 helper (s3_storage.py)
# You can reuse the MLflow values above, or set these explicitly.
# S3_BUCKET defaults to MLFLOW_ARTIFACT_BUCKET if unset.
# S3_ENDPOINT_URL defaults to MLFLOW_S3_ENDPOINT_URL if unset.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_PREFIX=
# S3_ADDRESSING_STYLE=path
